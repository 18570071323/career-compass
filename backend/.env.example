# ===== 数据库 =====
# PostgreSQL（生产/完整环境，asyncpg 驱动）
# DATABASE_URL=postgresql+asyncpg://resume:resume@localhost:5432/resume_saas
# 本地轻量联调用 SQLite（免装数据库；JSONB 字段自动降级为 JSON）
DATABASE_URL=sqlite+aiosqlite:///./data/resume.db

# ===== Redis（队列 Broker / 缓存 / 限流）=====
REDIS_URL=redis://localhost:6379/0

# ===== Coze 对接（可选备用引擎；主引擎见下方 DeepSeek）=====
# 国内环境 https://api.coze.cn ；海外 https://api.coze.com
COZE_BASE_URL=https://api.coze.cn
# 个人访问令牌 PAT（Coze 控制台 -> API 授权 -> 创建 Token），形如 pat_xxxxx
COZE_API_TOKEN=
# 简历分析工作流 ID（发布后获取），形如 7462xxxx
COZE_WORKFLOW_ID=
# 工作流入参/出参名（默认即工作流定义，一般无需改）
COZE_FILE_INPUT_KEY=resume_file
COZE_JD_INPUT_KEY=jd_text
COZE_REPORT_OUTPUT_KEY=report
COZE_SCORE_OUTPUT_KEY=score_result
# 限流（按套餐 RPM）
COZE_RATE_LIMIT_RPM=60
# 异步轮询参数
COZE_POLL_INTERVAL=3.0
COZE_POLL_MAX_WAIT=1800.0

# ===== 自研引擎：DeepSeek（主引擎，配置后自动启用真实分析）=====
# API Key：platform.deepseek.com 获取（约 ¥1/百万 token）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 其他 =====
CORS_ORIGINS=["http://localhost:5173"]
DEBUG=false
# 对外访问地址（如有前端域名则填 https://你的域名，用于回调/文档链接）
# PUBLIC_BASE_URL=https://api.your-domain.com

# ===== 安全（生产务必修改）=====
# JWT 密钥：生产生成强随机串，例如 openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-in-production
JWT_EXPIRE_DAYS=7

# ===== C 端小程序「简历罗盘」（个人主体阶段一：人工开通次数包）=====
WX_APPID=wx3d09f84d9f829852
# 小程序 AppSecret（微信公众平台 mp.weixin.qq.com → 开发管理 → 开发设置 → AppSecret）
# 配置后自动切换真实 wx.login 登录；留空 = 开发模式（dev_ 前缀测试号，自动补给次数包，勿用于生产）
WX_SECRET=
# C 端 mp token 有效期（天）
MP_TOKEN_EXPIRE_DAYS=30
# 次数包定价 JSON（一般无需改）
# MP_PACK_PRICING={"1x":{"count":1,"price":9.9},"10x":{"count":10,"price":69},"50x":{"count":50,"price":299}}

# ===== 收款信息（账户页展示给 B 端客户线下转账用；按需修改）=====
# BILLING_CONTACT=联系销售开通：xxx
# BILLING_PAYEE=转账至对公账户：XX公司 6222 0000 0000 0000

# ===== M7.4 向量精排（可选）=====
# 启用后首次推荐会从 hf-mirror 下载 bge-small-zh-v1.5（~95MB，缓存到 .tools/hf-cache）；
# 模型不可用/未启用时自动回退 TF-IDF 余弦，不影响功能
VECTOR_RERANK_ENABLED=false
# VECTOR_RERANK_MODEL=BAAI/bge-small-zh-v1.5
# VECTOR_RERANK_WEIGHT=0.5

# ===== SMTP 邮件（可选，生产化 M8）=====
# 启用后：激活等高匹配通知会发邮件到租户用户邮箱；可用 POST /api/v1/settings/test-mail 自检
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465            # 465=SSL / 587=STARTTLS
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=               # 为空则用 SMTP_USER
SMTP_FROM_NAME=ResumeMatch
SMTP_TLS=ssl             # ssl / starttls / none
